@model List<Reserva>
@{
    ViewData["Title"] = "Reservas registradas";
}
<div class="page-head d-flex justify-content-between align-items-end flex-wrap gap-2">
    <div>
        <h1>Reservas registradas</h1>
        <p>Últimas reservas grabadas en el sistema.</p>
    </div>
    <a class="btn btn-primary" asp-action="Iniciar">Generar reserva</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="tabla-reservas">
            <thead><tr><th>Nro.</th><th>Cliente</th><th>Llegada</th><th>Salida</th><th class="text-end">Días</th><th class="text-end">Habitaciones</th><th class="text-end">Monto total</th><th></th></tr></thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td class="fw-semibold">@r.NumeroReserva</td>
                    <td>@r.Cliente.NombreCompleto</td>
                    <td>@r.FechaLlegada.Fecha()</td><td>@r.FechaSalida.Fecha()</td>
                    <td class="text-end">@r.CantidadDias</td>
                    <td class="text-end">@r.Detalle.Count</td>
                    <td class="text-end">@r.MontoTotal.Soles()</td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Detalle" asp-route-id="@r.NumeroReserva">Ver</a></td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="8" class="text-center text-muted py-4">Todavía no hay reservas registradas.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
